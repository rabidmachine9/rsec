{
	"tabWidth": 4,
	"useTabs": true,
	"overrides": [
		{
			"files": ["*.ts", "*.tsx", "*.html"],
			"options": {
				"tabWidth": 4,
				"useTabs": false,
				"htmlWhitespaceSensitivity": "ignore",
				"printWidth": 150
			}
		},
		{
			"files": ["*.css", "*.scss", "*.json"],
			"options": {
				"tabWidth": 2,
				"useTabs": false
			}
		}
	]
}
